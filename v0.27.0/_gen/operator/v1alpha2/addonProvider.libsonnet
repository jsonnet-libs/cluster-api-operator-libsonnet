    '#fetchConfig':: d.obj(help='"FetchConfig determines how the operator will fetch the components and metadata for the provider.\\nIf nil, the operator will try to fetch components according to default\\nembedded fetch configuration for the given kind and `ObjectMeta.Name`.\\nFor example, the infrastructure name `aws` will fetch artifacts from\\nhttps://github.com/kubernetes-sigs/cluster-api-provider-aws/releases."'),
    fetchConfig: {
      '#selector':: d.obj(help='"Selector to be used for fetching provider’s components and metadata from\\nConfigMaps stored inside the cluster. Each ConfigMap is expected to contain\\ncomponents and metadata for a specific version only.\\nNote: the name of the ConfigMap should be set to the version or to override this\\nadd a label like the following: provider.cluster.x-k8s.io/version=v1.4.3"'),
      selector: {
        '#matchExpressions':: d.obj(help='"matchExpressions is a list of label selector requirements. The requirements are ANDed."'),
        matchExpressions: {
          '#withKey':: d.fn(help='"key is the label key that the selector applies to."', args=[d.arg(name='key', type=d.T.string)]),
          withKey(key): { key: key },
          '#withOperator':: d.fn(help="\"operator represents a key's relationship to a set of values.\\nValid operators are In, NotIn, Exists and DoesNotExist.\"", args=[d.arg(name='operator', type=d.T.string)]),
          withOperator(operator): { operator: operator },
          '#withValues':: d.fn(help='"values is an array of string values. If the operator is In or NotIn,\\nthe values array must be non-empty. If the operator is Exists or DoesNotExist,\\nthe values array must be empty. This array is replaced during a strategic\\nmerge patch."', args=[d.arg(name='values', type=d.T.array)]),
          withValues(values): { values: if std.isArray(v=values) then values else [values] },
          '#withValuesMixin':: d.fn(help='"values is an array of string values. If the operator is In or NotIn,\\nthe values array must be non-empty. If the operator is Exists or DoesNotExist,\\nthe values array must be empty. This array is replaced during a strategic\\nmerge patch."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='values', type=d.T.array)]),
          withValuesMixin(values): { values+: if std.isArray(v=values) then values else [values] },
        },
        '#withMatchExpressions':: d.fn(help='"matchExpressions is a list of label selector requirements. The requirements are ANDed."', args=[d.arg(name='matchExpressions', type=d.T.array)]),
        withMatchExpressions(matchExpressions): { spec+: { fetchConfig+: { selector+: { matchExpressions: if std.isArray(v=matchExpressions) then matchExpressions else [matchExpressions] } } } },
        '#withMatchExpressionsMixin':: d.fn(help='"matchExpressions is a list of label selector requirements. The requirements are ANDed."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='matchExpressions', type=d.T.array)]),
        withMatchExpressionsMixin(matchExpressions): { spec+: { fetchConfig+: { selector+: { matchExpressions+: if std.isArray(v=matchExpressions) then matchExpressions else [matchExpressions] } } } },
        '#withMatchLabels':: d.fn(help='"matchLabels is a map of {key,value} pairs. A single {key,value} in the matchLabels\\nmap is equivalent to an element of matchExpressions, whose key field is \\"key\\", the\\noperator is \\"In\\", and the values array contains only \\"value\\". The requirements are ANDed."', args=[d.arg(name='matchLabels', type=d.T.object)]),
        withMatchLabels(matchLabels): { spec+: { fetchConfig+: { selector+: { matchLabels: matchLabels } } } },
        '#withMatchLabelsMixin':: d.fn(help='"matchLabels is a map of {key,value} pairs. A single {key,value} in the matchLabels\\nmap is equivalent to an element of matchExpressions, whose key field is \\"key\\", the\\noperator is \\"In\\", and the values array contains only \\"value\\". The requirements are ANDed."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='matchLabels', type=d.T.object)]),
        withMatchLabelsMixin(matchLabels): { spec+: { fetchConfig+: { selector+: { matchLabels+: matchLabels } } } },
      },
      '#withOci':: d.fn(help='"OCI to be used for fetching the provider’s components and metadata from an OCI artifact.\\nYou must set `providerSpec.Version` field for operator to pick up desired version of the release from GitHub.\\nIf the providerSpec.Version is missing, latest provider version from clusterctl defaults is used."', args=[d.arg(name='oci', type=d.T.string)]),
      withOci(oci): { spec+: { fetchConfig+: { oci: oci } } },
      '#withUrl':: d.fn(help='"URL to be used for fetching the provider’s components and metadata from a remote Github repository.\\nFor example, https://github.com/{owner}/{repository}/releases\\nYou must set `providerSpec.Version` field for operator to pick up\\ndesired version of the release from GitHub."', args=[d.arg(name='url', type=d.T.string)]),
      withUrl(url): { spec+: { fetchConfig+: { url: url } } },
    },
    '#manager':: d.obj(help='"Manager defines the properties that can be enabled on the controller manager for the provider."'),
    manager: {
      '#controller':: d.obj(help='"Controller contains global configuration options for controllers\\nregistered within this manager."'),
      controller: {
        '#withCacheSyncTimeout':: d.fn(help='"CacheSyncTimeout refers to the time limit set to wait for syncing caches.\\nDefaults to 2 minutes if not set."', args=[d.arg(name='cacheSyncTimeout', type=d.T.integer)]),
        withCacheSyncTimeout(cacheSyncTimeout): { spec+: { manager+: { controller+: { cacheSyncTimeout: cacheSyncTimeout } } } },
        '#withGroupKindConcurrency':: d.fn(help="\"GroupKindConcurrency is a map from a Kind to the number of concurrent reconciliation\\nallowed for that controller.\\n\\nWhen a controller is registered within this manager using the builder utilities,\\nusers have to specify the type the controller reconciles in the For(...) call.\\nIf the object's kind passed matches one of the keys in this map, the concurrency\\nfor that controller is set to the number specified.\\n\\nThe key is expected to be consistent in form with GroupKind.String(),\\ne.g. ReplicaSet in apps group (regardless of version) would be `ReplicaSet.apps`.\"", args=[d.arg(name='groupKindConcurrency', type=d.T.object)]),
        withGroupKindConcurrency(groupKindConcurrency): { spec+: { manager+: { controller+: { groupKindConcurrency: groupKindConcurrency } } } },
        '#withGroupKindConcurrencyMixin':: d.fn(help="\"GroupKindConcurrency is a map from a Kind to the number of concurrent reconciliation\\nallowed for that controller.\\n\\nWhen a controller is registered within this manager using the builder utilities,\\nusers have to specify the type the controller reconciles in the For(...) call.\\nIf the object's kind passed matches one of the keys in this map, the concurrency\\nfor that controller is set to the number specified.\\n\\nThe key is expected to be consistent in form with GroupKind.String(),\\ne.g. ReplicaSet in apps group (regardless of version) would be `ReplicaSet.apps`.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='groupKindConcurrency', type=d.T.object)]),
        withGroupKindConcurrencyMixin(groupKindConcurrency): { spec+: { manager+: { controller+: { groupKindConcurrency+: groupKindConcurrency } } } },
        '#withRecoverPanic':: d.fn(help='"RecoverPanic indicates if panics should be recovered."', args=[d.arg(name='recoverPanic', type=d.T.boolean)]),
        withRecoverPanic(recoverPanic): { spec+: { manager+: { controller+: { recoverPanic: recoverPanic } } } },
      },
      '#health':: d.obj(help='"Health contains the controller health configuration"'),
      health: {
        '#withHealthProbeBindAddress':: d.fn(help='"HealthProbeBindAddress is the TCP address that the controller should bind to\\nfor serving health probes\\nIt can be set to \\"0\\" or \\"\\" to disable serving the health probe."', args=[d.arg(name='healthProbeBindAddress', type=d.T.string)]),
        withHealthProbeBindAddress(healthProbeBindAddress): { spec+: { manager+: { health+: { healthProbeBindAddress: healthProbeBindAddress } } } },
        '#withLivenessEndpointName':: d.fn(help='"LivenessEndpointName, defaults to \\"healthz\\', args=[d.arg(name='livenessEndpointName', type=d.T.string)]),
        withLivenessEndpointName(livenessEndpointName): { spec+: { manager+: { health+: { livenessEndpointName: livenessEndpointName } } } },
        '#withReadinessEndpointName':: d.fn(help='"ReadinessEndpointName, defaults to \\"readyz\\', args=[d.arg(name='readinessEndpointName', type=d.T.string)]),
        withReadinessEndpointName(readinessEndpointName): { spec+: { manager+: { health+: { readinessEndpointName: readinessEndpointName } } } },
      },
      '#leaderElection':: d.obj(help='"LeaderElection is the LeaderElection config to be used when configuring\\nthe manager.Manager leader election"'),
      leaderElection: {
        '#withLeaderElect':: d.fn(help='"leaderElect enables a leader election client to gain leadership\\nbefore executing the main loop. Enable this when running replicated\\ncomponents for high availability."', args=[d.arg(name='leaderElect', type=d.T.boolean)]),
        withLeaderElect(leaderElect): { spec+: { manager+: { leaderElection+: { leaderElect: leaderElect } } } },
        '#withLeaseDuration':: d.fn(help='"leaseDuration is the duration that non-leader candidates will wait\\nafter observing a leadership renewal until attempting to acquire\\nleadership of a led but unrenewed leader slot. This is effectively the\\nmaximum duration that a leader can be stopped before it is replaced\\nby another candidate. This is only applicable if leader election is\\nenabled."', args=[d.arg(name='leaseDuration', type=d.T.string)]),
        withLeaseDuration(leaseDuration): { spec+: { manager+: { leaderElection+: { leaseDuration: leaseDuration } } } },
        '#withRenewDeadline':: d.fn(help='"renewDeadline is the interval between attempts by the acting master to\\nrenew a leadership slot before it stops leading. This must be less\\nthan or equal to the lease duration. This is only applicable if leader\\nelection is enabled."', args=[d.arg(name='renewDeadline', type=d.T.string)]),
        withRenewDeadline(renewDeadline): { spec+: { manager+: { leaderElection+: { renewDeadline: renewDeadline } } } },
        '#withResourceLock':: d.fn(help='"resourceLock indicates the resource object type that will be used to lock\\nduring leader election cycles."', args=[d.arg(name='resourceLock', type=d.T.string)]),
        withResourceLock(resourceLock): { spec+: { manager+: { leaderElection+: { resourceLock: resourceLock } } } },
        '#withResourceName':: d.fn(help='"resourceName indicates the name of resource object that will be used to lock\\nduring leader election cycles."', args=[d.arg(name='resourceName', type=d.T.string)]),
        withResourceName(resourceName): { spec+: { manager+: { leaderElection+: { resourceName: resourceName } } } },
        '#withResourceNamespace':: d.fn(help='"resourceName indicates the namespace of resource object that will be used to lock\\nduring leader election cycles."', args=[d.arg(name='resourceNamespace', type=d.T.string)]),
        withResourceNamespace(resourceNamespace): { spec+: { manager+: { leaderElection+: { resourceNamespace: resourceNamespace } } } },
        '#withRetryPeriod':: d.fn(help='"retryPeriod is the duration the clients should wait between attempting\\nacquisition and renewal of a leadership. This is only applicable if\\nleader election is enabled."', args=[d.arg(name='retryPeriod', type=d.T.string)]),
        withRetryPeriod(retryPeriod): { spec+: { manager+: { leaderElection+: { retryPeriod: retryPeriod } } } },
      },
      '#metrics':: d.obj(help='"Metrics contains the controller metrics configuration"'),
      metrics: {
        '#withBindAddress':: d.fn(help='"BindAddress is the TCP address that the controller should bind to\\nfor serving prometheus metrics.\\nIt can be set to \\"0\\" to disable the metrics serving.\\nNOTE: This field is deprecated, please use DiagnosticsAddress field"', args=[d.arg(name='bindAddress', type=d.T.string)]),
        withBindAddress(bindAddress): { spec+: { manager+: { metrics+: { bindAddress: bindAddress } } } },
        '#withDiagnosticsAddress':: d.fn(help='"DiagnosticsAddress is the TCP address that the controller should bind to\\nfor serving prometheus metric.\\nIt can be set to \\"0\\" to disable the metrics serving."', args=[d.arg(name='diagnosticsAddress', type=d.T.string)]),
        withDiagnosticsAddress(diagnosticsAddress): { spec+: { manager+: { metrics+: { diagnosticsAddress: diagnosticsAddress } } } },
        '#withInsecureDiagnostics':: d.fn(help='"InsecureDiagnostics indicates if insecure metrics serving should be enabled.\\nIf false, or not set, the diagnostics address will expose pprof endpoints too."', args=[d.arg(name='insecureDiagnostics', type=d.T.boolean)]),
        withInsecureDiagnostics(insecureDiagnostics): { spec+: { manager+: { metrics+: { insecureDiagnostics: insecureDiagnostics } } } },
      },
      '#webhook':: d.obj(help='"Webhook contains the controllers webhook configuration"'),
      webhook: {
        '#withCertDir':: d.fn(help='"CertDir is the directory that contains the server key and certificate.\\nif not set, webhook server would look up the server key and certificate in\\n{TempDir}/k8s-webhook-server/serving-certs. The server key and certificate\\nmust be named tls.key and tls.crt, respectively."', args=[d.arg(name='certDir', type=d.T.string)]),
        withCertDir(certDir): { spec+: { manager+: { webhook+: { certDir: certDir } } } },
        '#withHost':: d.fn(help='"Host is the hostname that the webhook server binds to.\\nIt is used to set webhook.Server.Host."', args=[d.arg(name='host', type=d.T.string)]),
        withHost(host): { spec+: { manager+: { webhook+: { host: host } } } },
        '#withPort':: d.fn(help='"Port is the port that the webhook server serves at.\\nIt is used to set webhook.Server.Port."', args=[d.arg(name='port', type=d.T.integer)]),
        withPort(port): { spec+: { manager+: { webhook+: { port: port } } } },
      },
      '#withAdditionalArgs':: d.fn(help="\"AdditionalArgs is a map of additional options that will be passed\\nin as container args to the provider's controller manager.\"", args=[d.arg(name='additionalArgs', type=d.T.object)]),
      withAdditionalArgs(additionalArgs): { spec+: { manager+: { additionalArgs: additionalArgs } } },
      '#withAdditionalArgsMixin':: d.fn(help="\"AdditionalArgs is a map of additional options that will be passed\\nin as container args to the provider's controller manager.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='additionalArgs', type=d.T.object)]),
      withAdditionalArgsMixin(additionalArgs): { spec+: { manager+: { additionalArgs+: additionalArgs } } },
      '#withCacheNamespace':: d.fn(help="\"CacheNamespace if specified restricts the manager's cache to watch objects in\\nthe desired namespace Defaults to all namespaces\\n\\nNote: If a namespace is specified, controllers can still Watch for a\\ncluster-scoped resource (e.g Node).  For namespaced resources the cache\\nwill only hold objects from the desired namespace.\"", args=[d.arg(name='cacheNamespace', type=d.T.string)]),
      withCacheNamespace(cacheNamespace): { spec+: { manager+: { cacheNamespace: cacheNamespace } } },
      '#withFeatureGates':: d.fn(help="\"FeatureGates define provider specific feature flags that will be passed\\nin as container args to the provider's controller manager.\\nController Manager flag is --feature-gates.\"", args=[d.arg(name='featureGates', type=d.T.object)]),
      withFeatureGates(featureGates): { spec+: { manager+: { featureGates: featureGates } } },
      '#withFeatureGatesMixin':: d.fn(help="\"FeatureGates define provider specific feature flags that will be passed\\nin as container args to the provider's controller manager.\\nController Manager flag is --feature-gates.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='featureGates', type=d.T.object)]),
      withFeatureGatesMixin(featureGates): { spec+: { manager+: { featureGates+: featureGates } } },
      '#withGracefulShutDown':: d.fn(help='"GracefulShutdownTimeout is the duration given to runnable to stop before the manager actually returns on stop.\\nTo disable graceful shutdown, set to time.Duration(0)\\nTo use graceful shutdown without timeout, set to a negative duration, e.G. time.Duration(-1)\\nThe graceful shutdown is skipped for safety reasons in case the leader election lease is lost."', args=[d.arg(name='gracefulShutDown', type=d.T.string)]),
      withGracefulShutDown(gracefulShutDown): { spec+: { manager+: { gracefulShutDown: gracefulShutDown } } },
      '#withMaxConcurrentReconciles':: d.fn(help='"MaxConcurrentReconciles is the maximum number of concurrent Reconciles\\nwhich can be run."', args=[d.arg(name='maxConcurrentReconciles', type=d.T.integer)]),
      withMaxConcurrentReconciles(maxConcurrentReconciles): { spec+: { manager+: { maxConcurrentReconciles: maxConcurrentReconciles } } },
      '#withProfilerAddress':: d.fn(help='"ProfilerAddress defines the bind address to expose the pprof profiler (e.g. localhost:6060).\\nDefault empty, meaning the profiler is disabled.\\nController Manager flag is --profiler-address."', args=[d.arg(name='profilerAddress', type=d.T.string)]),
      withProfilerAddress(profilerAddress): { spec+: { manager+: { profilerAddress: profilerAddress } } },
      '#withSyncPeriod':: d.fn(help='"SyncPeriod determines the minimum frequency at which watched resources are\\nreconciled. A lower period will correct entropy more quickly, but reduce\\nresponsiveness to change if there are many watched resources. Change this\\nvalue only if you know what you are doing. Defaults to 10 hours if unset.\\nthere will a 10 percent jitter between the SyncPeriod of all controllers\\nso that all controllers will not send list requests simultaneously."', args=[d.arg(name='syncPeriod', type=d.T.string)]),
      withSyncPeriod(syncPeriod): { spec+: { manager+: { syncPeriod: syncPeriod } } },
      '#withVerbosity':: d.fn(help='"Verbosity set the logs verbosity. Defaults to 1.\\nController Manager flag is --verbosity."', args=[d.arg(name='verbosity', type=d.T.integer)]),
      withVerbosity(verbosity): { spec+: { manager+: { verbosity: verbosity } } },
    },
    '#patches':: d.obj(help='"Patches are applied to the rendered provider manifests to customize the\\nprovider manifests. Patches support both strategic merge patch and RFC6902 JSON patches.\\nBoth `patches` and `manifestPatches` cannot be set at the same time."'),
    patches: {
      '#target':: d.obj(help='"Target defines the target object to which the patch should be applied."'),
      target: {
        '#withGroup':: d.fn(help='"Group is the API Group of the target object."', args=[d.arg(name='group', type=d.T.string)]),
        withGroup(group): { target+: { group: group } },
        '#withKind':: d.fn(help='"Kind is the kind of the target object."', args=[d.arg(name='kind', type=d.T.string)]),
        withKind(kind): { target+: { kind: kind } },
        '#withLabelSelector':: d.fn(help='"LabelSelector is a string that follows the label selection expression\\nhttps://kubernetes.io/docs/concepts/overview/working-with-objects/labels/#api"', args=[d.arg(name='labelSelector', type=d.T.string)]),
        withLabelSelector(labelSelector): { target+: { labelSelector: labelSelector } },
        '#withName':: d.fn(help='"Name is the name of the target object."', args=[d.arg(name='name', type=d.T.string)]),
        withName(name): { target+: { name: name } },
        '#withNamespace':: d.fn(help='"Namespace is the namespace of the target object."', args=[d.arg(name='namespace', type=d.T.string)]),
        withNamespace(namespace): { target+: { namespace: namespace } },
        '#withVersion':: d.fn(help='"Version is the API version of the target object."', args=[d.arg(name='version', type=d.T.string)]),
        withVersion(version): { target+: { version: version } },
      },
      '#withPatch':: d.fn(help='"Patch is content of the patch to be applied. It should be an inline yaml blob-string."', args=[d.arg(name='patch', type=d.T.string)]),
      withPatch(patch): { patch: patch },
    },
    '#withAdditionalDeployments':: d.fn(help='"AdditionalDeployments is a map of additional deployments that the provider\\nshould manage. The key is the name of the deployment and the value is the\\nDeploymentSpec."', args=[d.arg(name='additionalDeployments', type=d.T.object)]),
    withAdditionalDeployments(additionalDeployments): { spec+: { additionalDeployments: additionalDeployments } },
    '#withAdditionalDeploymentsMixin':: d.fn(help='"AdditionalDeployments is a map of additional deployments that the provider\\nshould manage. The key is the name of the deployment and the value is the\\nDeploymentSpec."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='additionalDeployments', type=d.T.object)]),
    withAdditionalDeploymentsMixin(additionalDeployments): { spec+: { additionalDeployments+: additionalDeployments } },
    '#withManifestPatches':: d.fn(help='"ManifestPatches are applied to rendered provider manifests to customize the\\nprovider manifests. Patches are applied in the order they are specified.\\nThe `kind` field must match the target object, and\\nif `apiVersion` is specified it will only be applied to matching objects.\\nThis should be an inline yaml blob-string https://datatracker.ietf.org/doc/html/rfc7396.\\nThis will be deprecated in future releases in favor of `patches`."', args=[d.arg(name='manifestPatches', type=d.T.array)]),
    withManifestPatches(manifestPatches): { spec+: { manifestPatches: if std.isArray(v=manifestPatches) then manifestPatches else [manifestPatches] } },
    '#withManifestPatchesMixin':: d.fn(help='"ManifestPatches are applied to rendered provider manifests to customize the\\nprovider manifests. Patches are applied in the order they are specified.\\nThe `kind` field must match the target object, and\\nif `apiVersion` is specified it will only be applied to matching objects.\\nThis should be an inline yaml blob-string https://datatracker.ietf.org/doc/html/rfc7396.\\nThis will be deprecated in future releases in favor of `patches`."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='manifestPatches', type=d.T.array)]),
    withManifestPatchesMixin(manifestPatches): { spec+: { manifestPatches+: if std.isArray(v=manifestPatches) then manifestPatches else [manifestPatches] } },
    '#withPatches':: d.fn(help='"Patches are applied to the rendered provider manifests to customize the\\nprovider manifests. Patches support both strategic merge patch and RFC6902 JSON patches.\\nBoth `patches` and `manifestPatches` cannot be set at the same time."', args=[d.arg(name='patches', type=d.T.array)]),
    withPatches(patches): { spec+: { patches: if std.isArray(v=patches) then patches else [patches] } },
    '#withPatchesMixin':: d.fn(help='"Patches are applied to the rendered provider manifests to customize the\\nprovider manifests. Patches support both strategic merge patch and RFC6902 JSON patches.\\nBoth `patches` and `manifestPatches` cannot be set at the same time."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='patches', type=d.T.array)]),
    withPatchesMixin(patches): { spec+: { patches+: if std.isArray(v=patches) then patches else [patches] } },
    '#withVersion':: d.fn(help='"Version indicates the provider version."', args=[d.arg(name='version', type=d.T.string)]),
    withVersion(version): { spec+: { version: version } },
  },
  '#mixin': 'ignore',
  mixin: self,
}
